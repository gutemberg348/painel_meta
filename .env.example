# Login fixo do administrador (altere antes de expor na internet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=

PORT=3000
# Porta local da VPS publicada pelo Docker. Use a mesma porta no proxy_pass do Nginx.
TOTALK_HOST_PORT=3038
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./data/totalk.sqlite
# Ative somente se estiver atrás de UM proxy confiável e usando HTTPS.
TRUST_PROXY=false

# Token permanente em Ajustes > Integrações > Integração via API.
FLW_API_BASE_URL=https://api.wts.chat/chat
FLW_API_TOKEN=
# Opcional: restringe a caixa de entrada ao ID de um único canal WhatsApp.
FLW_INBOX_CHANNEL_ID=
# Intervalo entre destinatários. Mínimo de 500 ms.
SEND_INTERVAL_MS=1000

# Opcional: URL HTTPS pública do seu servidor para receber callbacks.
# Na VPS, use PUBLIC_URL=https://totalk.testes-techcode.shop para ativar com WEBHOOK_SECRET.
PUBLIC_URL=
WEBHOOK_SECRET=

{
  "name": "totalk-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Painel administrativo de campanhas WhatsApp com Express e FLW Chat",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node test/browser.js",
    "flw:conexao": "node scripts/flw-conexao.js",
    "flw:templates": "node scripts/flw-templates.js",
    "format": "prettier --write src public views scripts test README.md package.json",
    "setup": "node scripts/setup.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "better-sqlite3": "^12.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "lucide": "^0.468.0",
    "web-push": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0"
  }
}
